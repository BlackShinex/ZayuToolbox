<Window x:Class="Zayu.App.WebView2InstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 / 修复 WebView2"
        Width="580"
        SizeToContent="Height"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusVisualStyle="{x:Null}"
        Background="#F5F5F8"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="20" Background="#E6FFFFFF" CornerRadius="18" BorderBrush="#80FFFFFF" BorderThickness="1"
            Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="安装 / 修复 WebView2 运行库" FontSize="21" FontWeight="SemiBold"
                           Foreground="#0F172A" TextWrapping="Wrap"/>
                <TextBlock Text="从 Microsoft 官方服务器下载 Evergreen Bootstrapper，校验数字签名后静默安装。"
                           FontSize="13" Foreground="#58536A" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <Border Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="9"
                        Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="CurrentStatusText" Text="当前状态：检测中…" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentDetailText" Text="—" FontSize="12" Foreground="#58536A"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="安装方式" FontSize="12" FontWeight="SemiBold" Foreground="#6E687F"
                           Margin="0,14,0,0"/>
                <CheckBox x:Name="AllUsersCheck" FocusVisualStyle="{x:Null}" Content="为所有用户安装（会请求管理员权限）"
                          FontSize="13" Foreground="#334155" Margin="0,10,0,0"/>
                <TextBlock x:Name="AllUsersHintText" Text="取消勾选则只安装到当前用户，不需要管理员权限。"
                           FontSize="13" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="LocalInstallerButton" Content="选择本地安装包…"
                            Style="{StaticResource CopyButton}" Click="LocalInstallerButton_Click"/>
                    <Button x:Name="StartButton" Content="开始安装" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="StartButton_Click"/>
                    <Button x:Name="CloseButton" Content="取消" Style="{StaticResource CopyButton}"
                            Margin="8,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>

                <Border x:Name="ProgressPanel" Visibility="Collapsed" Background="#F8FAFC"
                        BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="9" Padding="12,10"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <ProgressBar x:Name="InstallProgressBar" Height="4" IsIndeterminate="True"
                                     Foreground="#4F46E5" Background="#E0E7FF" BorderThickness="0"/>
                        <TextBlock x:Name="StatusText" Text="准备安装…" FontSize="12" Foreground="#475569"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBox x:Name="LogBox" FocusVisualStyle="{x:Null}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#475569"
                                 Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                 Padding="8" Margin="0,8,0,0" Height="118"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FooterHintText"
                           Text="安装包仅从 Microsoft 官方短链下载；下载完成后会校验 Microsoft Authenticode 数字签名，校验失败不会运行。"
                           FontSize="13" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
