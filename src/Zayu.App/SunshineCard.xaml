<UserControl x:Class="Zayu.App.SunshineCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Border Style="{StaticResource Card}" Margin="0,0,0,0" Padding="22">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FEF3C7">
                        <TextBlock Text="S" FontSize="16" FontWeight="Bold" Foreground="#B45309"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sunshine 版本自检" Style="{StaticResource SectionTitle}" FontSize="16.5"/>
                        <TextBlock Text="识别官方版 / 基地版 / 第三方构建，只读检测，不需要管理员权限"
                                   Style="{StaticResource SectionSubtitle}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="SunshineStatusChip" Background="#F1F5F9" CornerRadius="6"
                            Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="SunshineStatusText" Text="检测中…" FontSize="12"
                                   Foreground="#58536A"/>
                    </Border>
                    <Button x:Name="SunshineRefreshButton" Content="重新检测"
                            Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                            Click="SunshineRefreshButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SunshineHeadlineText" Text="正在检测 Sunshine…"
                               FontSize="19" FontWeight="SemiBold" Foreground="#334155"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="SunshineSummaryText" Text="读取安装记录与版本资源…"
                               FontSize="12.5" Foreground="#58536A" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SunshineCopyButton" Content="复制诊断"
                                Style="{StaticResource CopyButton}"
                                Click="SunshineCopyButton_Click" IsEnabled="False"/>
                        <Button x:Name="SunshineFolderButton" Content="安装目录"
                                Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                                Click="SunshineFolderButton_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="SunshineHintText"
                               Text="检测覆盖注册表安装记录、Sunshine.exe 版本资源、服务路径和安装目录指纹。"
                               FontSize="12.5" Foreground="#6E687F" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#66FFFFFF" BorderBrush="#70FFFFFF"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="安装详情" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6E687F"/>
                        <TextBlock x:Name="SunshineVersionText" Text="版本：--" FontSize="12"
                                   Foreground="#475569" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <TextBlock x:Name="SunshinePublisherText" Text="作者：--" FontSize="12"
                                   Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="SunshineInstallerText" Text="安装来源：--" FontSize="12"
                                   Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="SunshineServiceText" Text="服务：--" FontSize="11.5"
                                   Foreground="#58536A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="SunshinePathText" Text="安装路径：--" FontSize="11.5"
                                   Foreground="#6E687F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="SunshineServicePathText" Text="服务路径：--" FontSize="11.5"
                                   Foreground="#6E687F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="SunshineWarningBanner" Visibility="Collapsed" Background="#FFF7ED"
                    BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,9"
                    Margin="0,12,0,0">
                <TextBlock x:Name="SunshineWarningText" FontSize="12" Foreground="#B45309"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
