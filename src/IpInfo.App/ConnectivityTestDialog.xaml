<Window x:Class="IpInfo.App.ConnectivityTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络连通性测试"
        Width="640"
        SizeToContent="Height"
        MaxHeight="840"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F8"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="20" Background="#E6FFFFFF" CornerRadius="18" BorderBrush="#80FFFFFF" BorderThickness="1"
            Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="网络连通性测试" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="用手机建立一次连接，同时验证内网 / 外网的 IPv4 与 IPv6 连通性。"
                           FontSize="12" Foreground="#58536A" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <ToggleButton x:Name="LanModeToggle" Content="同一 Wi-Fi（内网）"
                                  Style="{StaticResource ToolToggle}"
                                  Background="#F1F5F9" BorderBrush="#E2E8F0"
                                  Checked="LanModeToggle_Checked" Unchecked="LanModeToggle_Unchecked"/>
                    <ToggleButton x:Name="WanModeToggle" Content="移动数据（公网）"
                                  Style="{StaticResource ToolToggle}" Margin="8,0,0,0"
                                  Background="#F1F5F9" BorderBrush="#E2E8F0"
                                  Checked="WanModeToggle_Checked" Unchecked="WanModeToggle_Unchecked"/>
                </StackPanel>
                <TextBlock x:Name="ModeHintText" Text="正在准备二维码…" FontSize="11.5"
                           Foreground="#6E687F" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14"
                        Padding="10" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True"/>
                </Border>
                <TextBlock x:Name="QrFallbackText" Text="二维码生成失败，请复制下方地址用手机浏览器打开。"
                           FontSize="11" Foreground="#B45309" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>

                <TextBlock Text="测试地址（包含本次随机令牌，仅用于本次测试，请勿分享）" FontSize="11"
                           Foreground="#6E687F" Margin="0,14,0,0"/>
                <TextBox x:Name="UrlBox" FocusVisualStyle="{x:Null}" IsReadOnly="True" FontFamily="Consolas"
                         FontSize="11" Foreground="#4338CA" Background="#F8FAFC" BorderBrush="#E2E8F0"
                         BorderThickness="1" Padding="9,7" Margin="0,6,0,0"
                         TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto" MaxHeight="72"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="CopyButton" Content="复制地址" Style="{StaticResource CopyButton}"
                            Click="CopyButton_Click"/>
                    <TextBlock x:Name="StatusText" Text="等待手机连接…" FontSize="11.5"
                               Foreground="#58536A" TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="InstructionsText" FontSize="11.5" Foreground="#6E687F"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="9"
                        Padding="11,9" Margin="0,10,0,0">
                    <TextBlock x:Name="ProbeText" Text="收到手机请求后，结果会同步显示在主窗口。"
                               FontSize="11" Foreground="#B45309" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="提示：二维码只在本机生成，不会上传；测试结束后临时 TCP 端口会自动关闭。"
                           FontSize="10.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,9,0,0"/>

                <TextBlock x:Name="CountdownText" Text="请阅读说明，3 秒后可以关闭" FontSize="11.5"
                           Foreground="#6E687F" Margin="0,10,0,0"/>

                <Button x:Name="CloseButton" Content="完成并关闭" IsEnabled="False" Width="130" Height="34"
                        HorizontalAlignment="Right" Style="{StaticResource CopyButton}"
                        Margin="0,10,0,0" Click="CloseButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
