                                            <TextBlock x:Name="NatDetailMappingText" Text="映射行为：--" FontSize="11"
                                                       Foreground="#475569" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="NatDetailPortText" Text="端口保持：--" FontSize="11"
                                                       Foreground="#475569" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="NatDetailServerText" Text="STUN 服务器：--" FontSize="10.5"
                                                       Foreground="#6E687F" Margin="0,3,0,0"
