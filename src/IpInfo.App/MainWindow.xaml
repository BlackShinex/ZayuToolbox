<Window x:Class="IpInfo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IpInfo.App"
        Title="杂鱼串流工具箱"
        Width="1180" Height="840"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 柔焦光晕背景 -->
        <Border Grid.RowSpan="3" Background="#B8F1ECFF" IsHitTestVisible="False"/>
        <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-300,-340,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#667C3AED" Offset="0"/>
                        <GradientStop Color="#007C3AED" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-260,-220,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5538BDF8" Offset="0"/>
                        <GradientStop Color="#0038BDF8" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="110"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-220,0,0,-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40FB7185" Offset="0"/>
                        <GradientStop Color="#00FB7185" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- 紫色主题薄雾 -->
        <Border Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#337C3AED" Offset="0"/>
                    <GradientStop Color="#1A38BDF8" Offset="0.55"/>
                    <GradientStop Color="#26FB7185" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 顶部标题栏：轻玻璃条 -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Padding="28,16"
                Background="#B8FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="#CCFFFFFF"
                            BorderBrush="#B3FFFFFF" BorderThickness="1">
                        <Image Source="/Assets/sunshine-logo.png" Stretch="Uniform" Margin="2"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="杂鱼串流工具箱" FontSize="20" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                        <TextBlock Text="网络诊断 · Sunshine 环境 · WebView2 运行库" FontSize="11.5"
                                   Foreground="#5F5A70" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#66FFFFFF" BorderBrush="#80FFFFFF"
                        BorderThickness="1" CornerRadius="999" Padding="11,5" VerticalAlignment="Center">
                    <TextBlock Text="LOCAL TOOLKIT" FontSize="9" FontWeight="SemiBold"
                               Foreground="#5F5A70"/>
                </Border>
            </Grid>
        </Border>

        <!-- 内容：左侧菜单 + 右侧页面 -->
        <Grid Grid.Row="1" Margin="18,16,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0" Background="#B3FFFFFF"
                    BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="18"
                    Effect="{DynamicResource SidebarShadow}">
                <DockPanel Margin="12,16,12,12">
                    <TextBlock DockPanel.Dock="Top" Text="工作台" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#5F5A70" Margin="10,0,0,10"/>

                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="#66FFFFFF"
                            BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="12"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="杂鱼串流工具箱" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#1D1D1F"/>
                            <TextBlock Text="v1.7 · 本地运行" FontSize="10" Foreground="#5F5A70"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="NavItemBorder" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="11" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Border x:Name="AccentBar" Width="3" Height="18"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            CornerRadius="2" Background="Transparent"/>
                                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="NavItemBorder" Property="Background" Value="#80FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="NavItemBorder" Property="Background" Value="#CCFFFFFF"/>
                                                    <Setter TargetName="NavItemBorder" Property="BorderBrush" Value="#B3FFFFFF"/>
                                                    <Setter TargetName="AccentBar" Property="Background" Value="#5B5BD6"/>
                                                    <Setter Property="Foreground" Value="#3730A3"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem IsSelected="True" AutomationProperties.Name="Sunshine 版本">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE706;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="Sunshine 版本" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="WebView2 运行库">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE774;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="WebView2 运行库" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="网络检测">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE968;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="网络检测" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="NAT 跃点跟踪">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="NAT 跃点跟踪" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer x:Name="NetworkScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="28,24,28,28">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <views:PageHeader Grid.Column="0" Title="网络检测"
                                      Subtitle="本机地址、公网出口、NAT 类型与 IPv6 入站可达性"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ToggleButton x:Name="RevealToggle" Content="显示 IP" Style="{StaticResource ToolToggle}"
                                      Checked="RevealToggle_Checked" Unchecked="RevealToggle_Unchecked"
                                      ToolTip="默认隐藏 IP 中间部分，点击显示完整地址"/>
                        <Button x:Name="RefreshButton" Content="开始检测" Style="{StaticResource PrimaryButton}"
                                Click="RefreshButton_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 本机 IPv4 -->
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="9" Background="#EEF2FF">
                                        <TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="#4F46E5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="本机 IPv4 地址" Style="{StaticResource SectionTitle}" FontSize="15.5"/>
                                        <TextBlock x:Name="Ipv4Summary" Text="正在读取…" Style="{StaticResource SectionSubtitle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#F1F5F9" CornerRadius="7" Padding="8,3">
                                    <TextBlock x:Name="Ipv4CountText" Text="0 个" FontSize="10.5" Foreground="#58536A"/>
                                </Border>
                            </Grid>

                            <ItemsControl x:Name="Ipv4List" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,9" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="BorderBrush" Value="#EEF2F7"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrimaryVisibility}" Value="Visible">
                                                            <Setter Property="BorderBrush" Value="#22C55E"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding DisplayAddress}"
                                                           FontFamily="Consolas" FontSize="{Binding AddressFontSize}"
                                                           FontWeight="SemiBold" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <DockPanel Grid.Row="1" Margin="0,5,0,0">
                                                    <Button DockPanel.Dock="Right" Content="复制" Tag="{Binding CopyAddress}"
                                                            Style="{StaticResource CopyButton}" Click="CopyIpButton_Click"
                                                            VerticalAlignment="Center"/>
                                                    <Border DockPanel.Dock="Left" Background="{Binding TagBackground}"
                                                            CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScopeLabel}" FontSize="10"
                                                                   Foreground="{Binding TagForeground}"/>
                                                    </Border>
                                                    <Border DockPanel.Dock="Left" Background="#EEF2FF" CornerRadius="5"
                                                            Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding PrimaryVisibility}">
                                                        <TextBlock Text="主地址" FontSize="10" Foreground="#4F46E5"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding AdapterText}" FontSize="10.5"
                                                               Foreground="#6E687F" Margin="7,0,8,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="Ipv4Empty" Visibility="Collapsed" Background="#66FFFFFF"
                                    CornerRadius="10" Padding="16" Margin="0,12,0,0">
                                <TextBlock Text="未检测到可用的 IPv4 地址" FontSize="12" Foreground="#6E687F"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="小提示" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBlock Text="· 默认隐藏 IP 中间部分，点击右上角「显示 IP」查看完整地址。"
                                           FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="· 每个地址右侧的「复制」按钮复制完整 IP。"
                                           FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="· IPv6 出现多个地址是正常现象：除主地址外，Windows 还会生成临时地址和链路本地地址。"
                                           FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="· 公网出口与 NAT 类型通过公共 STUN 服务器（UDP）检测，不经过第三方 HTTP 服务。"
                                           FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 本机 IPv6 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="9" Background="#F3E8FF">
                                        <TextBlock Text="6" FontSize="16" FontWeight="Bold" Foreground="#7E22CE"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="本机 IPv6 地址" Style="{StaticResource SectionTitle}" FontSize="15.5"/>
                                        <TextBlock x:Name="Ipv6Summary" Text="正在读取…" Style="{StaticResource SectionSubtitle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#F1F5F9" CornerRadius="7" Padding="8,3">
                                    <TextBlock x:Name="Ipv6CountText" Text="0 个" FontSize="10.5" Foreground="#58536A"/>
                                </Border>
                            </Grid>

                            <ItemsControl x:Name="Ipv6List" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,9" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="BorderBrush" Value="#EEF2F7"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrimaryVisibility}" Value="Visible">
                                                            <Setter Property="BorderBrush" Value="#22C55E"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding DisplayAddress}"
                                                           FontFamily="Consolas" FontSize="{Binding AddressFontSize}"
                                                           FontWeight="SemiBold" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <DockPanel Grid.Row="1" Margin="0,5,0,0">
                                                    <Button DockPanel.Dock="Right" Content="复制" Tag="{Binding CopyAddress}"
                                                            Style="{StaticResource CopyButton}" Click="CopyIpButton_Click"
                                                            VerticalAlignment="Center"/>
                                                    <Border DockPanel.Dock="Left" Background="{Binding TagBackground}"
                                                            CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScopeLabel}" FontSize="10"
                                                                   Foreground="{Binding TagForeground}"/>
                                                    </Border>
                                                    <Border DockPanel.Dock="Left" Background="#EEF2FF" CornerRadius="5"
                                                            Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding PrimaryVisibility}">
                                                        <TextBlock Text="主地址" FontSize="10" Foreground="#4F46E5"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding AdapterText}" FontSize="10.5"
                                                               Foreground="#6E687F" Margin="7,0,8,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="Ipv6Empty" Visibility="Collapsed" Background="#66FFFFFF"
                                    CornerRadius="10" Padding="16" Margin="0,12,0,0">
                                <TextBlock Text="未检测到可用的 IPv6 地址" FontSize="12" Foreground="#6E687F"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 公网 IP 与 NAT -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="公网 IP 与 NAT 类型" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Border Background="#EEF2FF" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="STUN" FontSize="9.5" FontWeight="SemiBold" Foreground="#4338CA"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ProgressText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#58536A" Visibility="Collapsed"/>
                        </Grid>

                        <ProgressBar x:Name="DetectProgressBar" Grid.Row="1" Height="3" IsIndeterminate="True"
                                     Foreground="#4F46E5" Background="#E0E7FF" BorderThickness="0"
                                     Margin="0,10,0,0" Visibility="Collapsed"/>

                        <Border x:Name="SummaryBanner" Grid.Row="2" Background="#EEF2FF" CornerRadius="10"
                                Padding="14,11" Margin="0,12,0,0">
                            <DockPanel>
                                <Border x:Name="SummaryDot" Width="8" Height="8" CornerRadius="4"
                                        Background="#6366F1" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="SummaryText" Text="正在获取网络信息…" FontSize="12.5"
                                           Foreground="#3730A3" TextWrapping="Wrap" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="公网出口 IP" FontSize="11" FontWeight="SemiBold" Foreground="#6E687F"/>

                                <Border Background="#66FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10" Margin="0,7,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#E0E7FF" CornerRadius="6"
                                                Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="IPv4" FontSize="10.5" FontWeight="SemiBold" Foreground="#4338CA"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ExternalIpv4Text" Text="--" FontFamily="Consolas"
                                                       FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border x:Name="Ipv4StatusChip" Background="#F1F5F9" CornerRadius="5"
                                                    Padding="5,0" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <TextBlock x:Name="Ipv4StatusText" Text="未知" FontSize="10"
                                                           Foreground="#58536A"/>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="ExternalIpv4CopyButton" Grid.Column="2" Content="复制"
                                                Tag="" IsEnabled="False" Style="{StaticResource CopyButton}"
                                                Click="CopyIpButton_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="#66FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10" Margin="0,7,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F3E8FF" CornerRadius="6"
                                                Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="IPv6" FontSize="10.5" FontWeight="SemiBold" Foreground="#7E22CE"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ExternalIpv6Text" Text="--" FontFamily="Consolas"
                                                       FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border x:Name="Ipv6StatusChip" Background="#F1F5F9" CornerRadius="5"
                                                    Padding="5,0" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <TextBlock x:Name="Ipv6StatusText" Text="未知" FontSize="10"
                                                           Foreground="#58536A"/>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="ExternalIpv6CopyButton" Grid.Column="2" Content="复制"
                                                Tag="" IsEnabled="False" Style="{StaticResource CopyButton}"
                                                Click="CopyIpButton_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#66FFFFFF" BorderBrush="#70FFFFFF"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="NAT 类型" FontSize="11" FontWeight="SemiBold" Foreground="#6E687F"/>
                                    <TextBlock x:Name="NatTypeText" Text="检测中…" FontSize="18" FontWeight="SemiBold"
                                               Foreground="#334155" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NatDescriptionText" Text="正在分析当前网络的 NAT 行为…"
                                               FontSize="11" Foreground="#58536A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Border Background="#FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1"
                                            CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="NatDetailMappingText" Text="映射行为：--" FontSize="11"
                                                       Foreground="#475569" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="NatDetailPortText" Text="端口保持：--" FontSize="11"
                                                       Foreground="#475569" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="NatDetailServerText" Text="STUN 服务器：--" FontSize="10.5"
                                                       Foreground="#6E687F" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Expander x:Name="NatDetailExpander" Grid.Row="4" Margin="0,10,0,0" FontSize="11.5"
                                  Foreground="#58536A" Header="查看检测详情" Visibility="Collapsed">
                            <Border Background="#66FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                                    <ItemsControl x:Name="StepsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="#58536A"
                                                           TextWrapping="Wrap" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                        <Border x:Name="ErrorBanner" Grid.Row="5" Visibility="Collapsed" Background="#FEF2F2"
                                BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,9"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- IPv6 入站自检 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#E0E7FF">
                                <TextBlock Text="6" FontSize="15" FontWeight="Bold" Foreground="#4338CA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="IPv6 入站可达性" Style="{StaticResource SectionTitle}" FontSize="15.5"/>
                                <TextBlock Text="用手机移动数据验证公网 IPv6 能否被外部主动连入"
                                           Style="{StaticResource SectionSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="有公网 IPv6 不代表能入站：光猫/路由器的 IPv6 防火墙常默认拦截。启动自检后，按弹窗提示用手机移动数据打开自测地址。"
                                           FontSize="11.5" Foreground="#58536A" TextWrapping="Wrap"/>
                                <Border x:Name="InboundUrlPanel" Visibility="Collapsed" Background="#66FFFFFF"
                                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                        Padding="10,8" Margin="0,10,0,0">
                                    <TextBlock x:Name="InboundUrlText" Text="--" FontFamily="Consolas" FontSize="11"
                                               Foreground="#4338CA" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock x:Name="InboundStatusText" Text="尚未启动自检" FontSize="11"
                                           Foreground="#6E687F" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="InboundStartButton" Content="启动入站自检" IsEnabled="False"
                                            Style="{StaticResource CopyButton}" Click="InboundStartButton_Click"/>
                                    <Button x:Name="InboundCopyButton" Content="复制地址" Visibility="Collapsed"
                                            Style="{StaticResource CopyButton}" Click="InboundCopyButton_Click"
                                            Margin="6,0,0,0"/>
                                    <Button x:Name="InboundStopButton" Content="停止" Visibility="Collapsed"
                                            Style="{StaticResource CopyButton}" Click="InboundStopButton_Click"
                                            Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="InboundHintText" Text="提示：自检会在本机临时打开一个 TCP 端口，检测结束后自动关闭。"
                                           FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#66FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Windows 防火墙" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#6E687F"/>
                                    <TextBlock x:Name="FirewallText" Text="正在读取 Windows 防火墙状态…" FontSize="10.5"
                                               Foreground="#58536A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="为什么必须用移动数据？" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#6E687F" Margin="0,12,0,0"/>
                                    <TextBlock Text="如果手机仍连着本机 Wi-Fi，访问会走内网，无法代表外部 IPv6 入站是否放行。关闭 Wi-Fi 后使用 4G/5G，才能真实测试。"
                                               FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="点击「启动入站自检」后会弹出说明窗口，3 秒倒计时结束才能关闭。"
                                               FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

                <ScrollViewer x:Name="NatHopScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,28">
                    <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <views:PageHeader Grid.Column="0" Title="NAT 跃点跟踪"
                                      Subtitle="逐跳探测出口路径，判断是否存在多层 NAT"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ToggleButton x:Name="HopRevealToggle" Content="显示 IP" Style="{StaticResource ToolToggle}"
                                      Checked="HopRevealToggle_Checked" Unchecked="HopRevealToggle_Unchecked"
                                      ToolTip="默认隐藏跃点地址中间部分，点击显示完整地址"/>
                        <Button x:Name="HopRefreshButton" Content="开始检测" Style="{StaticResource PrimaryButton}"
                                Click="HopRefreshButton_Click" Margin="8,0,0,0"/>
                        <Button x:Name="NatTraceStopButton" Content="停止" Visibility="Collapsed"
                                Style="{StaticResource CopyButton}" Click="NatTraceStopButton_Click"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 多层 NAT 跃点跟踪 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,0" Padding="22">
                    <StackPanel>
                        <ProgressBar x:Name="NatTraceProgressBar" Height="3" IsIndeterminate="True"
                                     Foreground="#C2410C" Background="#FFEDD5" BorderThickness="0"
                                     Margin="0,0,0,0" Visibility="Collapsed"/>

                        <Border x:Name="NatTraceSummaryBanner" Background="#EEF2FF" CornerRadius="10"
                                Padding="14,11" Margin="0,0,0,0">
                            <TextBlock x:Name="NatTraceSummaryText"
                                       Text="尚未开始。点击右上「开始检测」逐跳探测到公网出口。"
                                       FontSize="12" Foreground="#3730A3" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="跳" FontSize="10.5" FontWeight="SemiBold" Foreground="#6E687F"/>
                            <TextBlock Grid.Column="1" Text="地址 / 说明" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#6E687F"/>
                            <TextBlock Grid.Column="2" Text="延迟" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#6E687F" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Background="#66FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                                <ItemsControl x:Name="NatHopList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="86"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TtlText}" FontFamily="Consolas"
                                                           FontSize="11" Foreground="#58536A" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AddressText}" FontFamily="Consolas"
                                                                   FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="{Binding TagBackground}" CornerRadius="5"
                                                                Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ScopeLabel}" FontSize="9.5"
                                                                       Foreground="{Binding TagForeground}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Note}" FontSize="10"
                                                               Foreground="#6E687F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding RoundTripText}"
                                                           FontFamily="Consolas" FontSize="10.5"
                                                           Foreground="#58536A" HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock x:Name="NatTraceHintText"
                                   Text="目标：阿里公共 DNS · 最多 30 跳 · 仅 ICMP，不需要管理员权限。跃点只代表三层路径；私网/CGNAT 跃点提示可能存在 NAT 层，实际 NAT 设备数需结合拓扑确认。"
                                   FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="WebView2ScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,28">
                    <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <views:PageHeader Grid.Column="0" Title="WebView2 运行库"
                                      Subtitle="检测 Microsoft Edge WebView2 Evergreen 运行库，支持安装与修复"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border x:Name="WebView2StatusChip" Background="#F1F5F9" CornerRadius="7"
                                Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="WebView2StatusText" Text="检测中…" FontSize="11"
                                       Foreground="#58536A"/>
                        </Border>
                        <Button x:Name="WebView2RefreshButton" Content="重新检测"
                                Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                                Click="WebView2RefreshButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- WebView2 运行库 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,0" Padding="22">
                    <StackPanel>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="WebView2HeadlineText" Text="正在检测 WebView2 运行库…"
                                           FontSize="18" FontWeight="SemiBold" Foreground="#334155"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="WebView2SummaryText" Text="读取注册表与安装目录…"
                                           FontSize="11.5" Foreground="#58536A" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="WebView2InstallButton" Content="安装 WebView2"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="WebView2InstallButton_Click" IsEnabled="False"/>
                                    <Button x:Name="WebView2CopyButton" Content="复制诊断"
                                            Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                                            Click="WebView2CopyButton_Click" IsEnabled="False"/>
                                    <Button x:Name="WebView2FolderButton" Content="安装目录"
                                            Style="{StaticResource CopyButton}" Margin="6,0,0,0"
                                            Click="WebView2FolderButton_Click" IsEnabled="False"/>
                                    <Button x:Name="WebView2OfficialButton" Content="官方下载页"
                                            Style="{StaticResource CopyButton}" Margin="6,0,0,0"
                                            Click="WebView2OfficialButton_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="WebView2HintText"
                                           Text="安装包从 Microsoft 官方服务器下载，并校验 Microsoft 数字签名后静默安装。"
                                           FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#66FFFFFF" BorderBrush="#70FFFFFF"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="运行库详情" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#6E687F"/>
                                    <TextBlock x:Name="WebView2VersionText" Text="版本：--" FontSize="11"
                                               Foreground="#475569" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="WebView2ScopeText" Text="范围：--" FontSize="11"
                                               Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="WebView2ArchText" Text="架构：--" FontSize="11"
                                               Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="WebView2SourceText" Text="来源：--" FontSize="11"
                                               Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="WebView2PathText" Text="路径：--" FontSize="10.5"
                                               Foreground="#58536A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="WebView2EdgeText" Text="Edge 浏览器：--" FontSize="10.5"
                                               Foreground="#6E687F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="WebView2PermissionText" Text="权限：--" FontSize="10.5"
                                               Foreground="#6E687F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="WebView2WarningBanner" Visibility="Collapsed" Background="#FFF7ED"
                                BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,9"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="WebView2WarningText" FontSize="11" Foreground="#B45309"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SunshineScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,28">
                    <StackPanel>
                        <views:PageHeader Title="Sunshine 环境" Subtitle="版本、服务与虚拟显示器的一站式检查"
                                          Margin="0,0,0,16"/>

                        <!-- Sunshine 版本自检 -->
                        <views:SunshineCard x:Name="VersionCardView"/>

                        <!-- Sunshine 服务状态 -->
                        <views:SunshineServiceCard x:Name="ServiceCardView"/>

                        <!-- Zako 虚拟显示器 -->
                        <views:ZakoDisplayCard x:Name="ZakoCardView"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border x:Name="FooterBorder" Grid.Row="2" Background="#B8FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <TextBlock x:Name="TimestampText" Text="检测时间 --" FontSize="11.5" Foreground="#5F5A70"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Text="杂鱼串流工具箱 v1.7 · 作者 BlackCat · 数据仅在本机处理"
                           HorizontalAlignment="Right" FontSize="11.5" Foreground="#5F5A70"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
