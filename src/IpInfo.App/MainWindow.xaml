                            <Border Background="#66FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                                    <ItemsControl x:Name="StepsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="#58536A"
                                                           TextWrapping="Wrap" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                        <Border x:Name="ErrorBanner" Grid.Row="5" Visibility="Collapsed" Background="#FEF2F2"
                                BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,9"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 网络连通性测试 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#E0E7FF">
                                    <TextBlock Text="&#x2194;" FontSize="17" FontWeight="Bold" Foreground="#4338CA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="网络连通性测试" Style="{StaticResource SectionTitle}" FontSize="15.5"/>
                                    <TextBlock Text="同时验证内网 / 外网的 IPv4 与 IPv6，判断能否建立有效 P2P 连接"
                                               Style="{StaticResource SectionSubtitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="ConnectivityStartButton" Content="启动测试并显示二维码" IsEnabled="False"
                                        Style="{StaticResource PrimaryButton}" Click="ConnectivityStartButton_Click"/>
                                <Button x:Name="ConnectivityStopButton" Content="停止" Visibility="Collapsed"
                                        Style="{StaticResource CopyButton}" Click="ConnectivityStopButton_Click"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ConnectivityVerdictBanner" Background="#EEF2FF" CornerRadius="10"
                                Padding="14,11" Margin="0,14,0,0">
                            <DockPanel>
                                <Border x:Name="ConnectivityVerdictDot" Width="8" Height="8" CornerRadius="4"
                                        Background="#6366F1" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ConnectivityVerdictText" Text="尚未测试"
                                           FontSize="12.5" Foreground="#3730A3" TextWrapping="Wrap"
                                           Margin="10,0,0,0"/>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="测试矩阵" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#6E687F"/>
                                <ItemsControl x:Name="ConnectivityList" Margin="0,7,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#66FFFFFF" BorderBrush="#70FFFFFF"
                                                    BorderThickness="1" CornerRadius="9" Padding="11,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#334155"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                                   Foreground="#6E687F" TextWrapping="Wrap"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                                            CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusForeground}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ConnectivityStatusText" Text="尚未测试"
                                           FontSize="11" Foreground="#6E687F" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#66FFFFFF" BorderBrush="#70FFFFFF"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Windows 防火墙" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#6E687F"/>
                                    <TextBlock x:Name="FirewallText" Text="正在读取 Windows 防火墙状态…" FontSize="10.5"
                                               Foreground="#58536A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="两种测试场景" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#6E687F" Margin="0,12,0,0"/>
                                    <TextBlock Text="· 同一 Wi-Fi：手机扫码访问电脑局域网地址，同时测试内网 IPv4 与 IPv6。"
                                               FontSize="10.5" Foreground="#6E687F" TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="· 移动数据：手机扫码访问公网 IPv6，测试外部入站是否放行。"
                                               FontSize="10.5" Foreground="#6E687F" TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                    <TextBlock Text="测试结束会自动关闭临时端口；二维码只在本机生成，不会上传。"
                                               FontSize="10.5" Foreground="#6E687F" TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="外网 IPv4 为公网出口 + NAT 类型判断，不等同于外部一定能连入。"
                                               FontSize="10.5" Foreground="#6E687F" TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

                <ScrollViewer x:Name="SelfCheckScrollViewer" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="28,24,28,28">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <views:PageHeader Grid.Column="0" Title="一键自检"
                                              Subtitle="汇总系统、Sunshine、网络与组件信息，快速定位串流问题"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <ToggleButton x:Name="SelfCheckRevealToggle" Content="显示 IP"
                                              Style="{StaticResource ToolToggle}"
                                              Checked="SelfCheckRevealToggle_Checked"
                                              Unchecked="SelfCheckRevealToggle_Unchecked"
                                              ToolTip="默认只遮罩报告中的公网 IP，局域网 IPv4 保持完整"/>
                                <Button x:Name="SelfCheckStartButton" Content="开始自检"
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                        Click="SelfCheckStartButton_Click"/>
                                <Button x:Name="SelfCheckCopyButton" Content="复制为截图"
                                        Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                                        IsEnabled="False" Click="SelfCheckCopyButton_Click"
                                        ToolTip="把当前报告表格复制为图片"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="SelfCheckProgressBar" Height="3" IsIndeterminate="True"
                                     Foreground="#4F46E5" Background="#E0E7FF" BorderThickness="0"
                                     Margin="0,0,0,10" Visibility="Collapsed"/>
                        <TextBlock x:Name="SelfCheckStatusText" Text="尚未自检，点击「开始自检」生成诊断报告。"
                                   FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <Border x:Name="SelfCheckReportCard" Background="#FFFFFF" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="16" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="杂鱼串流工具箱 · 一键自检报告"
                                                   FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock x:Name="SelfCheckMetaText" Text="尚未生成报告"
                                                   FontSize="11.5" Foreground="#6E687F" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#EEF2FF" CornerRadius="7" Padding="9,4">
                                        <TextBlock x:Name="SelfCheckPrivacyText" Text="公网 IP 已打码"
                                                   FontSize="10.5" Foreground="#4338CA"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#E2E8F0" Margin="0,14,0,6"/>

                                <TextBlock x:Name="SelfCheckEmptyText"
                                           Text="点击右上角「开始自检」，自动收集系统、Sunshine、网络、连通性和组件信息。"
                                           FontSize="12" Foreground="#6E687F" TextWrapping="Wrap"
                                           Margin="0,10,0,10"/>

                                <ItemsControl x:Name="SelfCheckRowsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="SelfCheckRowBorder" Background="Transparent"
                                                    CornerRadius="6" Padding="8,5" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelfCheckLabel" Text="{Binding Label}"
                                                               FontSize="11.5" Foreground="#475569"
                                                               VerticalAlignment="Top"/>
                                                    <TextBlock x:Name="SelfCheckValue" Grid.Column="1"
                                                               Text="{Binding Value}" FontSize="11.5"
                                                               Foreground="#0F172A" TextWrapping="Wrap"
                                                               VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                    <Setter TargetName="SelfCheckRowBorder" Property="Background" Value="#EEF2FF"/>
                                                    <Setter TargetName="SelfCheckLabel" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="SelfCheckLabel" Property="FontSize" Value="12"/>
                                                    <Setter TargetName="SelfCheckLabel" Property="Foreground" Value="#3730A3"/>
                                                    <Setter TargetName="SelfCheckValue" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="SelfCheckFooterText"
                                           Text="由 杂鱼串流工具箱生成 · 数据仅在本机处理"
                                           FontSize="10.5" Foreground="#6E687F" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ComponentStatusScrollViewer" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="28,24,28,28">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <views:PageHeader Grid.Column="0" Title="组件状态"
                                              Subtitle="检测基地版附带的显示、输入、音频与 USB 透传组件"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="ComponentRefreshButton" Content="刷新状态"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="ComponentRefreshButton_Click"/>
                                <Button x:Name="ComponentCopyButton" Content="复制诊断"
                                        Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                                        IsEnabled="False" Click="ComponentCopyButton_Click"/>
                                <Button x:Name="ComponentDeviceManagerButton" Content="设备管理器"
                                        Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                                        Click="ComponentDeviceManagerButton_Click"/>
                                <Button x:Name="ComponentToolsButton" Content="工具目录"
                                        Style="{StaticResource CopyButton}" Margin="8,0,0,0"
                                        Click="ComponentToolsButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="ComponentProgressBar" Height="3" IsIndeterminate="True"
                                     Foreground="#4F46E5" Background="#E0E7FF" BorderThickness="0"
                                     Margin="0,0,0,10" Visibility="Collapsed"/>
                        <TextBlock x:Name="ComponentStatusText" Text="尚未检测，点击「刷新状态」开始。"
                                   FontSize="12" Foreground="#6E687F" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="基地版组件状态" FontSize="17.5"
                                                   FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock x:Name="ComponentSummaryText" Text="尚未检测"
                                                   FontSize="12" Foreground="#6E687F" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#EEF2FF" CornerRadius="7" Padding="9,4">
                                        <TextBlock Text="只读检测" FontSize="11" Foreground="#4338CA"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#E2E8F0" Margin="0,14,0,6"/>

                                <ItemsControl x:Name="ComponentStatusList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ComponentRow" Background="#66FFFFFF"
                                                    BorderBrush="#70E2E8F0" BorderThickness="1"
                                                    CornerRadius="9" Padding="12,9" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock x:Name="ComponentName" Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#0F172A" TextWrapping="Wrap"
                                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <Border x:Name="ComponentStatusBorder"
                                                                Background="{Binding StatusBackground}"
                                                                CornerRadius="7" Padding="8,3"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Name="ComponentHealthText"
                                                                       Text="{Binding StatusText}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding StatusForeground}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock x:Name="ComponentDetail" Text="{Binding Detail}"
                                                               FontSize="12" Foreground="#6E687F"
                                                               TextWrapping="Wrap" LineHeight="18"
                                                               Margin="0,5,0,0"/>
                                                    <Grid x:Name="ComponentMeta" Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="ComponentDevice" Grid.Column="0"
                                                                   Text="{Binding DeviceId}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10.5" Foreground="#8A8499"
                                                                   TextWrapping="Wrap" Margin="0,0,14,0"/>
                                                        <TextBlock x:Name="ComponentVersion" Grid.Column="1"
                                                                   Text="{Binding Version, StringFormat=版本 {0}}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10.5" Foreground="#58536A"
                                                                   TextAlignment="Right" VerticalAlignment="Top"
                                                                   TextWrapping="Wrap"/>
                                                    </Grid>
                                                    <StackPanel x:Name="ComponentActions" Orientation="Horizontal"
                                                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                                                Visibility="Collapsed">
                                                        <Button x:Name="ComponentRepairButton" Content="修复"
                                                                Style="{StaticResource CopyButton}"
                                                                Padding="12,4" FontSize="11"
                                                                Background="#EEF2FF" BorderBrush="#C7D2FE"
                                                                Foreground="#4338CA"
                                                                Tag="{Binding Key}"
                                                                AutomationProperties.Name="修复组件"
                                                                Click="ComponentRepairButton_Click"/>
                                                        <Button x:Name="ComponentUninstallButton" Content="卸载"
                                                                Style="{StaticResource CopyButton}"
                                                                Padding="12,4" FontSize="11" Margin="6,0,0,0"
                                                                Background="#FEF2F2" BorderBrush="#FECACA"
                                                                Foreground="#B91C1C"
                                                                Tag="{Binding Key}"
                                                                AutomationProperties.Name="卸载组件"
                                                                Click="ComponentUninstallButton_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                    <Setter TargetName="ComponentRow" Property="Background" Value="#EEF2FF"/>
                                                    <Setter TargetName="ComponentRow" Property="BorderBrush" Value="#C7D2FE"/>
                                                    <Setter TargetName="ComponentRow" Property="Padding" Value="11,7"/>
                                                    <Setter TargetName="ComponentRow" Property="Margin" Value="0,7,0,4"/>
                                                    <Setter TargetName="ComponentName" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="ComponentName" Property="FontSize" Value="12.5"/>
                                                    <Setter TargetName="ComponentName" Property="Foreground" Value="#3730A3"/>
                                                    <Setter TargetName="ComponentDetail" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="ComponentMeta" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="ComponentStatusBorder" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="ComponentActions" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DeviceId}" Value="">
                                                    <Setter TargetName="ComponentDevice" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Version}" Value="">
                                                    <Setter TargetName="ComponentVersion" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasActions}" Value="True">
                                                    <Setter TargetName="ComponentActions" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanRepair}" Value="False">
                                                    <Setter TargetName="ComponentRepairButton" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanUninstall}" Value="False">
                                                    <Setter TargetName="ComponentUninstallButton" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="状态检测为只读；修复 / 卸载只对支持的组件开放，操作前会确认并请求管理员权限。"
                                           FontSize="11.5" Foreground="#6E687F" TextWrapping="Wrap"
                                           Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="WebView2ScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,28">
                    <StackPanel>
