<Window x:Class="IpInfo.App.InboundTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPv6 入站自检"
        Width="560"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F2F4F9"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="20" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E8ECF4" BorderThickness="1"
            Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="IPv6 入站自检" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="请先阅读并完成以下步骤，检测才能继续：" FontSize="12" Foreground="#64748B"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>

                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="9"
                        Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="必须使用手机移动数据" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#B45309"/>
                        <TextBlock Text="请关闭手机 Wi-Fi，并打开 4G/5G 移动数据。否则手机会从内网访问，无法验证 IPv6 入站。"
                                   FontSize="11" Foreground="#B45309" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="1. 关闭手机的 Wi-Fi；" FontSize="12" Foreground="#334155" Margin="0,14,0,0"/>
                <TextBlock Text="2. 打开手机的 4G/5G 移动数据；" FontSize="12" Foreground="#334155" Margin="0,5,0,0"/>
                <TextBlock Text="3. 复制下方地址，用手机浏览器打开；" FontSize="12" Foreground="#334155" Margin="0,5,0,0"/>
                <TextBlock Text="4. 保持本程序运行，返回主窗口查看检测结果。" FontSize="12" Foreground="#334155" Margin="0,5,0,0"/>

                <TextBlock Text="自测地址（包含完整 IPv6，仅用于本次检测，请勿公开分享）" FontSize="10.5"
                           Foreground="#94A3B8" Margin="0,16,0,0"/>
                <TextBox x:Name="UrlBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                         Foreground="#4338CA" Background="#F8FAFC" BorderBrush="#E2E8F0"
                         BorderThickness="1" Padding="10,8" Margin="0,6,0,0"
                         TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto" MaxHeight="80"/>
                <Button x:Name="CopyButton" Content="复制地址" Style="{StaticResource CopyButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyButton_Click"/>

                <TextBlock x:Name="StatusText" Text="等待外部连接…" FontSize="11.5" Foreground="#64748B"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock x:Name="CountdownText" Text="请阅读说明，3 秒后可以关闭" FontSize="10.5"
                           Foreground="#94A3B8" Margin="0,5,0,0"/>

                <Button x:Name="CloseButton" Content="了解" IsEnabled="False" Width="110" Height="34"
                        HorizontalAlignment="Right" Style="{StaticResource CopyButton}"
                        Margin="0,14,0,0" Click="CloseButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
